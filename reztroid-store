    function loadProducts() {
      const stored = localStorage.getItem('reztroid_products');
      if (stored) {
        try { return JSON.parse(stored); } catch (e) { return DEFAULT_PRODUCTS; }
      }
      return DEFAULT_PRODUCTS;
