    function saveProducts(prods) {
      localStorage.setItem('reztroid_products', JSON.stringify(prods));
    }

    function loadAdminWa() {
      return localStorage.getItem('reztroid_admin_wa') || "6281234567890";
    }

    function saveAdminWa(number) {
      localStorage.setItem('reztroid_admin_wa', number);
    }

    let PRODUCTS = loadProducts();
    let currentAdminWa = loadAdminWa();
    let cart = [];
    let selectedCategory = 'all';
    let searchQuery = '';

    const productGrid = document.getElementById('productGrid');
    const emptyCatalog = document.getElementById('emptyCatalog');
    const searchInput = document.getElementById('searchInput');
    const categoryTabs = document.getElementById('categoryTabs');
    const openCartBtn = document.getElementById('openCartBtn');
    const closeCartBtn = document.getElementById('closeCartBtn');
    const cartDrawer = document.getElementById('cartDrawer');
    const cartBackdrop = document.getElementById('cartBackdrop');
    const cartItemList = document.getElementById('cartItemList');
    const emptyCartState = document.getElementById('emptyCartState');
    const cartSubtotal = document.getElementById('cartSubtotal');
    const cartCountBadge = document.getElementById('cartCountBadge');
    const checkoutBtn = document.getElementById('checkoutBtn');

    const secretAdminTrigger = document.getElementById('secretAdminTrigger');
    const adminAuthModal = document.getElementById('adminAuthModal');
    const adminAuthForm = document.getElementById('adminAuthForm');
    const adminPasswordInput = document.getElementById('adminPasswordInput');
    const adminAuthError = document.getElementById('adminAuthError');
    const closeAuthModalBtn = document.getElementById('closeAuthModalBtn');
    const adminPanelDrawer = document.getElementById('adminPanelDrawer');
    const closeAdminPanelBtn = document.getElementById('closeAdminPanelBtn');
    const adminResetDataBtn = document.getElementById('adminResetDataBtn');
    const adminWaInput = document.getElementById('adminWaInput');
    const adminSaveWaBtn = document.getElementById('adminSaveWaBtn');
    const adminProductList = document.getElementById('adminProductList');
    const adminProdTotal = document.getElementById('adminProdTotal');
    const adminAddProductBtn = document.getElementById('adminAddProductBtn');

    function formatRupiah(num) {
      return "Rp " + Number(num).toLocaleString('id-ID');
    }

    function renderCatalog() {
      productGrid.innerHTML = '';

      const filtered = PRODUCTS.filter(prod => {
        const matchCategory = (selectedCategory === 'all') || (prod.category === selectedCategory);
        const matchSearch = prod.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                            prod.desc.toLowerCase().includes(searchQuery.toLowerCase());
        return matchCategory && matchSearch;
      });

      if (filtered.length === 0) {
        emptyCatalog.classList.remove('hidden');
      } else {
        emptyCatalog.classList.add('hidden');
        filtered.forEach(p => {
          const defaultOpt = p.options[0] || { duration: "Reguler", price: 0 };
          const isOut = p.isReady === false;
          const card = document.createElement('div');
          card.className = `bg-white border-2 ${isOut ? 'border-slate-200 opacity-60' : 'border-slate-200 hover:border-black'} rounded-3xl p-6 flex flex-col justify-between transition-all duration-200 ${isOut ? '' : 'hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_#000]'}`;
          
          card.innerHTML = `
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="w-12 h-12 rounded-2xl ${p.color || 'bg-slate-900'} text-white flex items-center justify-center font-bold shadow-sm">
                  <i data-lucide="${p.icon || 'box'}" class="w-6 h-6"></i>
                </div>
                <div class="flex items-center gap-1.5">
                  ${isOut ? '<span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-rose-100 text-rose-700 border border-rose-200">Habis</span>' : ''}
                  <span class="text-[11px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                    ${p.tag || 'Resmi'}
                  </span>
                </div>
              </div>

              <h3 class="font-extrabold text-lg text-slate-950 mb-1 leading-snug">${p.name}</h3>
              <p class="text-xs text-slate-500 font-medium leading-relaxed mb-4">${p.desc}</p>

              <div class="space-y-1.5 mb-5">
                <label class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">Pilihan Paket:</label>
                <select id="select-${p.id}" ${isOut ? 'disabled' : ''} class="w-full bg-slate-50 border border-slate-200 font-bold text-xs rounded-xl p-2.5 outline-none focus:border-black transition">
                  ${p.options.map((opt, i) => `
                    <option value="${i}">${opt.duration} —${formatRupiah(opt.price)}</option>
                  `).join('')}
                </select>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
              <div>
                <span class="text-[10px] text-slate-400 font-bold block uppercase tracking-wider">Mulai dari</span>
                <span id="priceDisplay-${p.id}" class="text-base font-black text-slate-900">${formatRupiah(defaultOpt.price)}</span>
              </div>

              <button 
                onclick="addToCart('${p.id}')" 
                ${isOut ? 'disabled' : ''} 
                class="${isOut ? 'bg-slate-300 text-slate-500 cursor-not-allowed' : 'bg-black hover:bg-slate-800 text-white active:scale-95'} px-4 py-2.5 rounded-xl font-bold text-xs flex items-center gap-1.5 transition"
              >
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>${isOut ? 'Habis' : '+ Keranjang'}</span>
              </button>
            </div>
          `;

          const selectElement = card.querySelector(`#select-${p.id}`);
          const priceDisplay = card.querySelector(`#priceDisplay-${p.id}`);
          if (selectElement) {
            selectElement.addEventListener('change', (e) => {
              const chosen = p.options[e.target.value];
              if (chosen) priceDisplay.textContent = formatRupiah(chosen.price);
            });
          }

          productGrid.appendChild(card);
        });
      }
      lucide.createIcons();
    }

    window.addToCart = function(productId) {
      const product = PRODUCTS.find(p => p.id === productId);
      if (!product || product.isReady === false) return;

      const selectEl = document.getElementById(`select-${product.id}`);
      const selectedIndex = parseInt(selectEl.value, 10);
      const chosenOption = product.options[selectedIndex];

      const existing = cart.find(item => item.id === product.id && item.duration === chosenOption.duration);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({
          id: product.id,
          name: product.name,
          duration: chosenOption.duration,
          price: chosenOption.price,
          quantity: 1
        });
      }

      updateCartUI();
      openCart();
    };

    function updateCartUI() {
      const totalItems = cart.reduce((acc, item) => acc + item.quantity, 0);
      cartCountBadge.textContent = totalItems;

      if (cart.length === 0) {
        cartItemList.innerHTML = '';
        emptyCartState.classList.remove('hidden');
        cartSubtotal.textContent = 'Rp 0';
        checkoutBtn.disabled = true;
        return;
      }

      emptyCartState.classList.add('hidden');
      checkoutBtn.disabled = false;
      cartItemList.innerHTML = '';

      let total = 0;

      cart.forEach((item, index) => {
        total += item.price * item.quantity;
        const itemEl = document.createElement('div');
        itemEl.className = "p-3.5 rounded-2xl border border-slate-200 bg-white flex items-center justify-between gap-3 shadow-sm";
        itemEl.innerHTML = `
          <div class="flex-1 min-w-0">
            <h4 class="font-extrabold text-xs text-slate-900 truncate">${item.name}</h4>
            <p class="text-[11px] text-slate-500 font-semibold">${item.duration}</p>
            <p class="text-xs font-bold text-indigo-600 mt-1">${formatRupiah(item.price)}</p>
          </div>

          <div class="flex items-center gap-2">
            <div class="flex items-center border border-slate-200 rounded-lg overflow-hidden bg-slate-50">
              <button onclick="changeQty(${index}, -1)" class="px-2 py-1 text-slate-600 hover:bg-slate-200 text-xs font-bold transition">−</button>
              <span class="px-2 py-1 text-xs font-extrabold text-slate-900">${item.quantity}</span>
              <button onclick="changeQty(${index}, 1)" class="px-2 py-1 text-slate-600 hover:bg-slate-200 text-xs font-bold transition">+</button>
            </div>

            <button onclick="removeFromCart(${index})" class="text-slate-400 hover:text-red-500 p-1 rounded transition">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          </div>
        `;
        cartItemList.appendChild(itemEl);
      });

      cartSubtotal.textContent = formatRupiah(total);
      lucide.createIcons();
    }

    window.changeQty = function(index, delta) {
      if (!cart[index]) return;
      cart[index].quantity += delta;
      if (cart[index].quantity <= 0) cart.splice(index, 1);
      updateCartUI();
    };

    window.removeFromCart = function(index) {
      cart.splice(index, 1);
      updateCartUI();
    };

    function openCart() {
      cartBackdrop.classList.remove('hidden');
      cartDrawer.classList.remove('translate-x-full');
    }

    function closeCart() {
      cartDrawer.classList.add('translate-x-full');
      cartBackdrop.classList.add('hidden');
    }

    function handleWhatsAppCheckout() {
      if (cart.length === 0) return;

      let subtotal = 0;
      let orderLines = "";

      cart.forEach((item, i) => {
        const itemTotal = item.price * item.quantity;
        subtotal += itemTotal;
        orderLines += `${i + 1}. *${item.name}*\n   - Paket: ${item.duration}\n   - Qty: ${item.quantity}x\n   - Harga: ${formatRupiah(itemTotal)}\n`;
      });

      const message = 
`Halo Admin reztroid®, saya mau order aplikasi:

${orderLines}
---------------------------------
*TOTAL:* ${formatRupiah(subtotal)}
---------------------------------

Mohon info instruksi pembayaran (QRIS / Bank) ya. Terima kasih!`;

      const encodedMessage = encodeURIComponent(message);
      const waUrl = `https://wa.me/${currentAdminWa}?text=${encodedMessage}`;
      window.open(waUrl, '_blank');
    }

    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      renderCatalog();
    });

    categoryTabs.addEventListener('click', (e) => {
      const btn = e.target.closest('.cat-btn');
      if (!btn) return;

      document.querySelectorAll('.cat-btn').forEach(b => {
        b.className = "cat-btn px-5 py-2 rounded-xl text-xs sm:text-sm font-extrabold border-2 border-slate-200 bg-white text-slate-700 hover:border-slate-400 transition whitespace-nowrap active:scale-95";
      });

      btn.className = "cat-btn px-5 py-2 rounded-xl text-xs sm:text-sm font-extrabold border-2 border-black bg-black text-white transition whitespace-nowrap active:scale-95";
      selectedCategory = btn.getAttribute('data-cat');
      renderCatalog();
    });

    openCartBtn.addEventListener('click', openCart);
    closeCartBtn.addEventListener('click', closeCart);
    cartBackdrop.addEventListener('click', () => {
      closeCart();
      closeAdminPanel();
    });
    checkoutBtn.addEventListener('click', handleWhatsAppCheckout);

    // TRIGGER KLIK 3X & VERIFIKASI SANDI LANGSUNG
    let secretClickCount = 0;
    let secretClickTimer = null;

    secretAdminTrigger.addEventListener('click', () => {
      secretClickCount++;
      clearTimeout(secretClickTimer);

      if (secretClickCount === 3) {
        secretClickCount = 0;
        openAuthModal();
      } else {
        secretClickTimer = setTimeout(() => {
          secretClickCount = 0;
        }, 800);
      }
    });

    function openAuthModal() {
      adminAuthModal.classList.remove('hidden');
      adminAuthModal.classList.add('flex');
      adminPasswordInput.value = '';
      adminAuthError.classList.add('hidden');
      adminPasswordInput.focus();
      lucide.createIcons();
    }

    function closeAuthModal() {
      adminAuthModal.classList.add('hidden');
      adminAuthModal.classList.remove('flex');
    }

    closeAuthModalBtn.addEventListener('click', closeAuthModal);

    // Password check langsung presisi
    adminAuthForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const enteredPass = adminPasswordInput.value.trim();

      if (enteredPass === "Helter#2026!") {
        closeAuthModal();
        openAdminPanel();
      } else {
        adminAuthError.classList.remove('hidden');
      }
    });

    function openAdminPanel() {
      adminWaInput.value = currentAdminWa;
      renderAdminProducts();
      cartBackdrop.classList.remove('hidden');
      adminPanelDrawer.classList.remove('translate-x-full');
      lucide.createIcons();
    }

    function closeAdminPanel() {
      adminPanelDrawer.classList.add('translate-x-full');
      cartBackdrop.classList.add('hidden');
    }

    closeAdminPanelBtn.addEventListener('click', closeAdminPanel);

    adminSaveWaBtn.addEventListener('click', () => {
      const cleanWa = adminWaInput.value.replace(/[^0-9]/g, '');
      if (cleanWa) {
        currentAdminWa = cleanWa;
        saveAdminWa(cleanWa);
        alert('Nomor WhatsApp admin berhasil disimpan: ' + cleanWa);
      }
    });

    adminResetDataBtn.addEventListener('click', () => {
      if (confirm('Yakin ingin mereset semua produk ke data awal?')) {
        PRODUCTS = JSON.parse(JSON.stringify(DEFAULT_PRODUCTS));
        saveProducts(PRODUCTS);
        renderCatalog();
        renderAdminProducts();
      }
    });

    function renderAdminProducts() {
      adminProdTotal.textContent = PRODUCTS.length;
      adminProductList.innerHTML = '';

      PRODUCTS.forEach((prod, idx) => {
        const item = document.createElement('div');
        item.className = "p-4 rounded-xl border border-slate-200 bg-white space-y-3";
        item.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="font-extrabold text-xs text-slate-900">${prod.name}</span>
            <div class="flex items-center gap-2">
              <button onclick="toggleProductStock(${idx})" class="text-[10px] font-bold px-2.5 py-1 rounded-md border ${prod.isReady !== false ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200'}">
                ${prod.isReady !== false ? 'Status: READY' : 'Status: HABIS'}
              </button>
              <button onclick="deleteProduct(${idx})" class="text-rose-500 hover:text-rose-700 p-1">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            <div>
              <label class="text-[10px] font-bold text-slate-400 uppercase">Tag Promo:</label>
              <input type="text" value="${prod.tag || ''}" onchange="updateProductTag(${idx}, this.value)" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-1.5 font-bold text-slate-700">
            </div>
            <div>
              <label class="text-[10px] font-bold text-slate-400 uppercase">Harga Utama (${prod.options[0]?.duration || 'Default'}):</label>
              <input type="number" value="${prod.options[0]?.price || 0}" onchange="updateProductPrice(${idx}, 0, this.value)" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-1.5 font-bold text-slate-700">
            </div>
          </div>
        `;
        adminProductList.appendChild(item);
      });
      lucide.createIcons();
    }

    window.toggleProductStock = function(index) {
      PRODUCTS[index].isReady = (PRODUCTS[index].isReady === false) ? true : false;
      saveProducts(PRODUCTS);
      renderCatalog();
      renderAdminProducts();
    };

    window.updateProductTag = function(index, newTag) {
      PRODUCTS[index].tag = newTag;
      saveProducts(PRODUCTS);
      renderCatalog();
    };

    window.updateProductPrice = function(index, optionIndex, newPrice) {
      if (PRODUCTS[index].options[optionIndex]) {
        PRODUCTS[index].options[optionIndex].price = Number(newPrice);
        saveProducts(PRODUCTS);
        renderCatalog();
      }
    };

    window.deleteProduct = function(index) {
      if (confirm(`Hapus "${PRODUCTS[index].name}" dari katalog?`)) {
        PRODUCTS.splice(index, 1);
        saveProducts(PRODUCTS);
        renderCatalog();
        renderAdminProducts();
      }
    };

    adminAddProductBtn.addEventListener('click', () => {
      const name = document.getElementById('newProdName').value.trim();
      const category = document.getElementById('newProdCategory').value;
      const desc = document.getElementById('newProdDesc').value.trim();
      const duration = document.getElementById('newProdDuration').value.trim() || '1 Bulan';
      const price = Number(document.getElementById('newProdPrice').value) || 25000;

      if (!name) {
        alert('Nama aplikasi wajib diisi!');
        return;
      }

      const newId = name.toLowerCase().replace(/[^a-z0-9]/g, '-') + '-' + Date.now().toString().slice(-4);

      PRODUCTS.unshift({
        id: newId,
        name: name,
        category: category,
        tag: "Terbaru",
        desc: desc || "Aplikasi premium bergaransi resmi.",
        color: "bg-indigo-600",
        icon: "sparkles",
        isReady: true,
        options: [
          { duration: duration, price: price }
        ]
      });

      saveProducts(PRODUCTS);
      renderCatalog();
      renderAdminProducts();

      document.getElementById('newProdName').value = '';
      document.getElementById('newProdDesc').value = '';
      document.getElementById('newProdPrice').value = '';
      alert('Produk berhasil ditambahkan ke katalog!');
    });

    window.addEventListener('DOMContentLoaded', () => {
      renderCatalog();
      updateCartUI();
      lucide.createIcons();
    });
  </script>
</body>
</html>

